    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/katex": "^0.16.7",
    "@types/node": "^26.4.1",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/test-utils": "^2.5.1",
    "esbuild": "0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",

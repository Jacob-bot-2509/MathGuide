# 复制本文件为 .env.local 并填入真实 Key(.env.local 已被 gitignore,不会上传 GitHub)
# 平台地址为固定值,无需修改;模型名以各平台控制台显示为准

# ---- 阿里云百炼(OpenAI 兼容端点) ----
MG_ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MG_ALIYUN_API_KEY=sk-你的阿里云key

# ---- 智谱开放平台 ----
MG_ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
MG_ZHIPU_API_KEY=你的智谱key

# ---- 角色分配(平台:模型名) ----
# 主力:日常问答 / 查询改写 / 精排 / 综合
MG_ROLE_MAIN=aliyun:qwen3.8-flash
# 备胎:主力平台故障时自动切换(异平台容灾)
MG_ROLE_BACKUP=zhipu:glm-5.2
# 深答:证明 / 竞赛 / 复杂问题路由
MG_ROLE_DEEP=aliyun:qwen3.8-max
# 长文:长文档分析(长上下文)
MG_ROLE_LONG=aliyun:qwen-long

# ---- 可选:向量检索(语义召回,与 LLM 同平台 key 即可) ----
# MG_EMBED_BASE_URL=(阿里云百炼 compatible-mode 端点,与 MG_ALIYUN_BASE_URL 相同)
# MG_EMBED_API_KEY=(与 MG_ALIYUN_API_KEY 相同)
# MG_EMBED_MODEL=text-embedding-v3

# ---- 可选:深度搜索增强 ----
# Semantic Scholar 免费 key(专属配额,告别 429)
# MG_S2_API_KEY=
# OpenAlex 礼貌池邮箱
# MG_CONTACT_MAIL=

# ---- 运行模式与安全 ----
# 演示模式:1=允许固定验证码 123456、微信/QQ 访客登录与开放注册(仅限本机演示)。
# 守卫:MG_DEMO_MODE=1 且绑定 --host 非 127.0.0.1/localhost/::1,或 CORS 含公网来源时,
# 后端会直接拒绝启动。真实部署必须设为 0,演示通道与 /register 会关闭,
# 账号由真实验证流程创建。
MG_DEMO_MODE=1
# 游客账号上限(0=禁止访客登录);超出时先清理无有效 token 的最旧游客
MG_GUEST_MAX=500
# 测评邀请码(逗号分隔)。关闭演示模式后,只有持有效邀请码的手机号可注册。
# 例:MG_INVITE_CODES=eval-2026-a,eval-2026-b
# MG_INVITE_CODES=
# 认证限流(按客户端 IP;多人共用实验室出口 IP 时可调大)
MG_AUTH_RATE_MAX=10
MG_AUTH_RATE_WINDOW=60
# 留存清理(0=关闭;默认不自动删,按实验周期显式开启)
# 账号超过 N 天未登录则删除,管理员白名单永久保留
# MG_ACCOUNT_TTL_DAYS=180
# 用量记录超过 N 天则删除(JSONL 与旧备份都清)
# MG_USAGE_TTL_DAYS=90
# 反向代理若没有传 X-Forwarded-Proto,可强制后端发 HSTS(确认 HTTPS 正常后再开)
# MG_ENABLE_HSTS=1
# 允许跨域的前端来源(逗号分隔),默认只放行本机 vite
MG_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# /api/stats 管理员白名单(手机号或 uid,逗号分隔);不配则无人可访问
# MG_ADMIN_PHONES=13600136000
# MG_ADMIN_UIDS=

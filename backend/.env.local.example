# 复制本文件为 .env.local 并填入真实 Key(.env.local 已被 gitignore,不会上传 GitHub)
# 平台地址为固定值,无需修改;模型名以各平台控制台显示为准

# ---- 阿里云百炼(OpenAI 兼容端点) ----
MG_ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MG_ALIYUN_API_KEY=sk-你的阿里云key

# ---- 智谱开放平台 ----
MG_ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
MG_ZHIPU_API_KEY=你的智谱key

# ---- 角色分配(平台:模型名) ----
# 主力:日常问答 / 查询改写 / 精排 / 综合
MG_ROLE_MAIN=aliyun:qwen3.8-flash
# 备胎:主力平台故障时自动切换(异平台容灾)
MG_ROLE_BACKUP=zhipu:glm-5.2
# 深答:证明 / 竞赛 / 复杂问题路由
MG_ROLE_DEEP=aliyun:qwen3-235b-a22b
# 长文:长文档分析(长上下文)
MG_ROLE_LONG=aliyun:qwen-long

# ---- 可选:向量检索(语义召回,与 LLM 同平台 key 即可) ----
# MG_EMBED_BASE_URL=(阿里云百炼 compatible-mode 端点,与 MG_ALIYUN_BASE_URL 相同)
# MG_EMBED_API_KEY=(与 MG_ALIYUN_API_KEY 相同)
# MG_EMBED_MODEL=text-embedding-v3

# ---- 可选:深度搜索增强 ----
# Semantic Scholar 免费 key(专属配额,告别 429)
# MG_S2_API_KEY=
# OpenAlex 礼貌池邮箱
# MG_CONTACT_MAIL=

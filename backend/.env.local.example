# 复制本文件为 .env.local 并填入真实 Key(.env.local 已被 gitignore,不会上传 GitHub)
# 平台地址为固定值,无需修改;模型名以各平台控制台显示为准

# ---- 阿里云百炼(OpenAI 兼容端点) ----
MG_ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MG_ALIYUN_API_KEY=sk-你的阿里云key

# ---- 智谱开放平台 ----
MG_ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
MG_ZHIPU_API_KEY=你的智谱key

# ---- DeepSeek(可选,OpenAI 兼容) ----
# 只配 key 即可;base 默认 https://api.deepseek.com/v1
# MG_DEEPSEEK_API_KEY=sk-你的DeepSeekKey
# MG_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ---- 角色分配(平台:模型名) ----
# 可用平台:aliyun / zhipu / deepseek;按账号实际开通的模型填写
# 主力:日常问答 / 查询改写 / 精排 / 综合
MG_ROLE_MAIN=aliyun:qwen3.8-flash
# 备胎:主力平台故障时自动切换(异平台容灾)
MG_ROLE_BACKUP=zhipu:glm-5.2
# 深答:证明 / 竞赛 / 复杂问题路由
MG_ROLE_DEEP=aliyun:qwen3.8-max
# 长文:长文档分析(长上下文)
MG_ROLE_LONG=aliyun:qwen-long

# ---- 可选:向量检索(语义召回,与 LLM 同平台 key 即可) ----
# MG_EMBED_BASE_URL=(阿里云百炼 compatible-mode 端点,与 MG_ALIYUN_BASE_URL 相同)
# MG_EMBED_API_KEY=(与 MG_ALIYUN_API_KEY 相同)
# MG_EMBED_MODEL=text-embedding-v3

# ---- 可选:深度搜索增强 ----
# Semantic Scholar 免费 key(专属配额,告别 429)
# MG_S2_API_KEY=
# OpenAlex 礼貌池邮箱
# MG_CONTACT_MAIL=
# OpenAlex 专属 key(可选,与上面邮箱二选一即可)
# MG_OPENALEX_API_KEY=
# PubMed / ADS 专属 key(可选,提高配额)
# MG_NCBI_API_KEY=
# MG_ADS_API_KEY=
# 文献源礼貌池邮箱(Crossref/OpenAlex/Unpaywall 共用,填真实邮箱才进礼貌池)
# MG_LITERATURE_MAILTO=
# Unpaywall 开放获取查询邮箱(留空则跳过 Unpaywall)
# MG_UNPAYWALL_EMAIL=

# ---- 可选:公式与整页识别(Vision) ----
# 不配则跳过整页/手写识别,只做文本提取
# MG_VISION_API_KEY=
# MG_VISION_BASE_URL=
# MG_VISION_MODEL=

# ---- 可选:科研存储配额 ----
# 单文件上传上限(MB),默认 100,有效范围 1~200
# MG_RESEARCH_MAX_UPLOAD_MB=
# 单账号文档数上限,默认 200,有效范围 1~5000
# MG_RESEARCH_MAX_DOCS=
# 单账号总占用上限(MB),默认 500,有效范围 1~10240
# MG_RESEARCH_MAX_TOTAL_MB=

# ---- 运行模式与安全 ----
# 演示模式:1=允许固定验证码 123456、微信/QQ 访客登录与开放注册(仅限本机演示)。
# 守卫:MG_DEMO_MODE=1 且绑定 --host 非 127.0.0.1/localhost/::1,或 CORS 含公网来源时,
# 后端会直接拒绝启动。真实部署必须设为 0,演示通道与 /register 会关闭,
# 账号由真实验证流程创建。
MG_DEMO_MODE=1
# 图解告警 webhook(可选):只发聚合指标/原因,不发问题、回答或用户身份;留空关闭。
# MG_DIAGRAM_ALERT_WEBHOOK=https://example.com/mathguide-alert
# 同类告警最小间隔(秒),默认 300。
# MG_DIAGRAM_ALERT_COOLDOWN=300
# 图解语义一致性检查(默认开):每张图多一次异源模型调用,判断图是否对题;
# 校验超时/失败时放行不拦图。设为 0 可关闭以省调用。
# MG_DIAGRAM_VERIFY=0
# 图解引擎:legacy=只用自绘 SVG/Three(默认);geogebra=优先 GeoGebra 命令,
# 页面仍由我们自己的 SVG/Three 渲染;校验/转换失败回退 legacy。auto 同 geogebra。
# 2D 接函数/切线/圆/交点;3D 只接点/线/段/平面/球/多边形,曲面/梯度继续 legacy。
# GeoGebra 仅非商用免费。
# MG_DIAGRAM_ENGINE=geogebra
# 游客账号上限(0=禁止访客登录);超出时先清理无有效 token 的最旧游客
MG_GUEST_MAX=500
# 测评邀请码(逗号分隔)。关闭演示模式后,只有持有效邀请码的手机号可注册。
# 例:MG_INVITE_CODES=eval-2026-a,eval-2026-b
# MG_INVITE_CODES=
# 认证限流(按客户端 IP;多人共用实验室出口 IP 时可调大)
MG_AUTH_RATE_MAX=10
MG_AUTH_RATE_WINDOW=60
# 双闸(默认关):机房/单位 NAT 共用一个出口 IP 时,把「每 IP 10 次」拆成
# 「IP 天花板 + 每账号额度」。打开后 MG_AUTH_RATE_MAX 变成**单账号**(同一手机号)
# 的额度,MG_AUTH_IP_RATE_MAX 是**整间机房每分钟过多少人**(按 人数 × 3 估)。
# 比单纯调大 MG_AUTH_RATE_MAX 安全:同一出口的不同账号互不影响,而单账号爆破
# 仍被锁在 MG_AUTH_RATE_MAX 次/窗口内。见 docs/DEPLOY_PLAYBOOK.md §五之三。
# MG_AUTH_DUAL_BUCKET=1
# MG_AUTH_IP_RATE_MAX=120
# 留存清理(0=关闭;默认不自动删,按实验周期显式开启)
# 账号超过 N 天未登录则删除,管理员白名单永久保留
# MG_ACCOUNT_TTL_DAYS=180
# 用量记录超过 N 天则删除(JSONL 与旧备份都清)
# MG_USAGE_TTL_DAYS=90
# 反向代理若没有传 X-Forwarded-Proto,可强制后端发 HSTS(确认 HTTPS 正常后再开)
# MG_ENABLE_HSTS=1
# 日志级别:DEBUG / INFO / WARNING / ERROR,默认 INFO;每条带模块名与 request_id,
# 不记录问题、回答正文与手机号
# MG_LOG_LEVEL=INFO
# 允许跨域的前端来源(逗号分隔),默认只放行本机 vite
MG_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 双域部署(learn.* / research.*)共享登录时必填父域,例:.example.com
# 留空 = host-only Cookie(本机开发/单域部署,凭据不外溢)
# MG_COOKIE_DOMAIN=
# 章节树检索(默认关):开启后每次检索多 1~2 次模型调用,没有评测集前不要开
# MG_TREE_WALK=0
# 危险:允许任意来源 host 触发服务端打开本地打印程序(仅本机演示用)
# MG_PRINT_OPEN=0
# 回归计算 worker 的解释器路径;留空则自动找 backend/.venv-analysis
# MG_ANALYSIS_PYTHON=
# 导出 PDF 用的 headless 浏览器。Windows 本机默认自动找 Edge;
# Linux 服务器装 chromium 后在这里显式指定(优先级最高,配错不会兜底):
#   apt install -y chromium fonts-noto-cjk   # 中文字体必须装,否则 PDF 里中文变方块
# MG_EDGE_PATH=/usr/bin/chromium
# PDF 打印超时(秒,默认 120,下限 10)。低配 VPS 上长文档常需要上调:
# MG_PDF_TIMEOUT=300
# 沙箱受限的机器(LXC/Docker 容器、Ubuntu 23.10+ 的 apparmor 限制)专用:
# 设为 1 时打印命令会追加 --no-sandbox / --disable-dev-shm-usage 兜底档。
# 生产渲染的是模型生成内容,沙箱该留着 → 公网部署**保持关闭**(默认)。
# 别猜:先跑 python tools/check_pdf.py,它会在两种设置下各印一次,告诉你这台机器
# 到底要不要开;若结论是"必须开",生产必须同为 1,否则线上导出仍是 500。
# MG_EDGE_NO_SANDBOX=0
# 导出并发闸门:每次导出都会起一个 headless 浏览器(峰值 100~300MB),
# 同时 N 个就把低配机器打 OOM。默认同时 2 个、排队 8 个、最多等 15 秒,
# 再多的请求直接 429 + Retry-After(前端提示"稍后重试"),不会起第 N+1 个浏览器。
# 机器内存 ≥ 4GB 可留默认;1GB 小机器建议 MG_PDF_CONCURRENCY=1;
# 4C8G(当前计划机型)建议 3:单次导出峰值实测约 460MB(Windows+Edge,Linux 未测),
# 先按 2 跑一次 tools/load_probe.py --export 2 看 RSS 峰值再上调,别凭规格猜。
# MG_PDF_CONCURRENCY=2
# MG_PDF_QUEUE=8
# MG_PDF_QUEUE_WAIT=15
# 无命令行 --host 时补的绑定地址(一般不用;演示模式仍只允许本机)
# MG_HOST=
# 每个账号每天的模型请求上限(0=不限,默认)。测评期用它兜住单账号刷爆额度:
# 按当天 usage 记录数计,超限返回 429(daily quota reached);空 prompt 的会话问候不计数。
# 【公网部署必须取消注释并填一个数,如 200】这是唯一的成本总闸:「每用户 6 次/分」是速率
# 不是总额,服务器余量充足时永远不会先报警;不设它,单账号理论上有 8640 次/天。
# 本地开发/自托管可保持注释(= 不限)。
# MG_DAILY_LLM_CALLS=200
# 每用户请求速率限流(默认 6 次/60 秒;chat 入口与各类导出/转写入口共用这一条)。
# 0 = 关闭:只给压测「测容量」用 —— 这条限流在贵的活之前判定,不关掉它,
# 高并发只会先撞 rate limited,量到的是限流而不是机器上限。压测完立刻删掉这行。
# 坏值(拼错/负数)回退 6,不会意外关闭。
# MG_CHAT_RATE_MAX=0
# MG_CHAT_RATE_WINDOW=60
# /api/stats 管理员白名单(手机号或 uid,逗号分隔);不配则无人可访问
# MG_ADMIN_PHONES=13600136000
# MG_ADMIN_UIDS=
# 组卷题库的来源分层过滤(MG_EXERCISE_TIERS),默认 safe。
# 现题库 backend/data/exercises/bilingual/all.jsonl 的 6,776 题全部是 research 层,
# 所以不设这一项 = 题库为空:计划接口 available 恒为 0,组卷接口回 422 no_evidence,
# 没有任何报错或日志(文件放对了也没用)。要出题就设成:
# MG_EXERCISE_TIERS=safe,research
# 真实客户端 IP 白名单(逗号分隔的 IP/CIDR):登录/注册/登出/导出/注销的「10 次/分/IP」
# 全靠它。规则只有两条:
#   1) 直连对端不在白名单 → X-Forwarded-For 一律忽略(客户端伪造无效);
#   2) 在 → 从右往左取第一个不在白名单里的地址(反代追加的那个),跳过自己叠的每一层反代。
# 经反代部署(公网)必须填反代地址,否则所有用户算成一个 IP:全站共享 10 次/分登录限流,
# 而且不会报错。反代不在本机(Docker/另一台机器)时填它的实际地址;前面挂 CDN 时
# 把 CDN 回源网段也加上(或让 nginx 做 set_real_ip_from)。
# 写成 * 或 0.0.0.0/0 会直接拒绝启动 —— 那不是配置,是把限流关掉。
# 本机开发/直接暴露(绑 0.0.0.0)可以留空。
# 另:启动命令要加 --no-proxy-headers(uvicorn 的 --proxy-headers 默认开着,会抢在
# 应用之前改写 scope["client"],后端就无从校验;见 deploy/mathguide.service)。
# MG_TRUSTED_PROXIES=127.0.0.1
# 验收用:设为 1 时 /api/health 返回 12 位客户端 IP 摘要(ref)+ 来源(via),
# 供 python tools/proxy_check.py 判断「伪造 XFF 有没有生效」「是不是全员一个桶」。
# 平时保持关闭(健康检查是公开接口)。
# MG_DIAG_CLIENT_IP=0

# MathGuide 生产环境示例。复制到 backend/.env.local 后填入真实值。
# 权限: chmod 600 backend/.env.local
# 注意: 本文件不含真实 Key，不要提交 backend/.env.local。

# 关闭演示通道；只允许邀请码注册
MG_DEMO_MODE=0
MG_INVITE_CODES=replace-with-invite-code-a,replace-with-invite-code-b
MG_ADMIN_PHONES=replace-with-admin-phone

# 组卷题库分层：现题库全在 research 层，不设这项组卷会静默返回空库
MG_EXERCISE_TIERS=safe,research
# 每账号每天模型调用上限（0=不限）；公网部署建议设置，兜住单账号刷额度
MG_DAILY_LLM_CALLS=200

# 双域部署时填父域 Cookie；单域部署留空或删除
# MG_COOKIE_DOMAIN=.gzhu.edu.cn
# 同域反代不需要 CORS；前后端不同源时再配
# MG_CORS_ORIGINS=https://learn.gzhu.edu.cn,https://research.gzhu.edu.cn
MG_AUTH_RATE_MAX=30
MG_AUTH_RATE_WINDOW=60
# 机房/NAT 共用一个出口 IP 时打开双闸：每账号额度 + 每 IP 天花板
# MG_AUTH_DUAL_BUCKET=1
# MG_AUTH_IP_RATE_MAX=120
MG_ENABLE_HSTS=1
MG_LOG_LEVEL=INFO

# 阿里云百炼（公共兼容端点，key 覆盖 main/long/vision/embedding）
MG_ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MG_ALIYUN_API_KEY=replace-with-aliyun-key

# 智谱开放平台（backup/deep）
MG_ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
MG_ZHIPU_API_KEY=replace-with-zhipu-key

# 角色路由
MG_ROLE_MAIN=aliyun:deepseek-v4.1-flash
MG_ROLE_BACKUP=zhipu:glm-5.3-flash
MG_ROLE_DEEP=zhipu:glm-5.3
MG_ROLE_LONG=aliyun:qwen-long

# Embedding：与阿里云共用 Key 和公共端点
MG_EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MG_EMBED_API_KEY=replace-with-aliyun-key
MG_EMBED_MODEL=qwen3.7-text-embedding

# 视觉：复用阿里云 Key
MG_VISION_MODEL=qwen3.8-omni-flash

# PDF 导出（Linux 服务器装 chromium 后建议显式指定）
# MG_EDGE_PATH=/usr/bin/chromium
# MG_PDF_TIMEOUT=300
# MG_PDF_CONCURRENCY=2
# MG_PDF_QUEUE=8
# MG_PDF_QUEUE_WAIT=15
# 仅沙箱受限机器按 tools/check_pdf.py 的结论开启；公网默认保持 0
# MG_EDGE_NO_SANDBOX=0

# 可选：留存清理
# MG_ACCOUNT_TTL_DAYS=180
# MG_USAGE_TTL_DAYS=90

# MathGuide 后端 systemd 示例。
# 路径按实际部署修改:User / WorkingDirectory / EnvironmentFile / ExecStart。
# data/ 是唯一需要写的目录,其余只读;umask 让数据文件默认不对其他用户开放。
# 例外:启用 MG_EMBED_*(向量检索)时 knowledge/ 也要可写,见下面的 ReadWritePaths。
# 双域部署时在 EnvironmentFile(.env.local)里设置:
#   MG_COOKIE_DOMAIN=.example.com
# 否则两个子域各自登录,共享登录不生效。

[Unit]
Description=MathGuide backend
After=network.target

[Service]
Type=simple
User=mathguide
Group=mathguide
WorkingDirectory=/srv/mathguide/backend
EnvironmentFile=/srv/mathguide/backend/.env.local
# 真实客户端 IP 的唯一开关(按 IP 限流靠它):写反代的实际地址,可逗号分隔多个/CIDR。
# 反代不在本机(Docker/另一台机器)时改成它的地址,如 172.17.0.1/32;前面挂 CDN 时
# 把 CDN 回源网段也加上。规则是「直连对端不在白名单 → X-Forwarded-For 一律忽略」,
# 所以白名单写错不会报错、而是全员塌成一个桶;写成 * 则直接拒绝启动。
# 详见 docs/DEPLOY_PLAYBOOK.md §一 第 4 条。
Environment=MG_TRUSTED_PROXIES=127.0.0.1
# 必须单进程(--workers 不要加):限流器、会话缓存、检索缓存都是进程内存,
# 多 worker 会让"每账号 N 次/分"变成 N×worker 倍且缓存各自分裂。
# --no-proxy-headers 不能省:uvicorn 的 --proxy-headers **默认开启**(白名单默认 127.0.0.1),
# 只要对端命中它自己的白名单就会先改写 scope["client"],后端就看不到真实对端、也无法校验
# 信任链(单层反代碰巧对,多挂 CDN 会按节点分桶)。关掉它,判定权才归 MG_TRUSTED_PROXIES。
ExecStart=/srv/mathguide/.venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port 8000 --no-proxy-headers
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/mathguide/backend/data
# 启用 MG_EMBED_*(向量检索)时取消下面这行注释:否则 knowledge/.embeddings.json 写不进去,
# 每次重启都要重新向量化全部知识片段(日志只有一条 WARN,账单上看不出原因)。
# ReadWritePaths=/srv/mathguide/backend/knowledge
StandardOutput=append:/var/log/mathguide/backend.log
StandardError=append:/var/log/mathguide/backend.log

[Install]
WantedBy=multi-user.target

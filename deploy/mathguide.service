# MathGuide 后端 systemd 示例。
# 路径按实际部署修改:User / WorkingDirectory / EnvironmentFile / ExecStart。
# data/ 是唯一需要写的目录,其余只读;umask 让数据文件默认不对其他用户开放。
# 双域部署时在 EnvironmentFile(.env.local)里设置:
#   MG_COOKIE_DOMAIN=.example.com
# 否则两个子域各自登录,共享登录不生效。

[Unit]
Description=MathGuide backend
After=network.target

[Service]
Type=simple
User=mathguide
Group=mathguide
WorkingDirectory=/srv/mathguide/backend
EnvironmentFile=/srv/mathguide/backend/.env.local
# 必须单进程(--workers 不要加):限流器、会话缓存、检索缓存都是进程内存,
# 多 worker 会让"每账号 N 次/分"变成 N×worker 倍且缓存各自分裂。
# --proxy-headers 让 request.client.host 取 nginx/caddy 传来的真实 IP(按 IP 限流依赖它)。
ExecStart=/srv/mathguide/.venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/mathguide/backend/data
StandardOutput=append:/var/log/mathguide/backend.log
StandardError=append:/var/log/mathguide/backend.log

[Install]
WantedBy=multi-user.target

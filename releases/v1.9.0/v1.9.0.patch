+    temp_store.TOKENS_PATH.write_text(
+        json.dumps({"tok": {"uid": "u-1"}}), encoding="utf-8")
+    temp_store.init()
+    assert temp_store.resolve_token("tok") is None
+
+    # 下一次签发会顺带清掉损坏记录

+    return rec
+
+
+def test_prune_guests_removes_oldest_inactive(temp_store):
+    for uid, created in (
+        ("guest-a", "2026-01-01"),
+        ("guest-b", "2026-01-02"),
+        ("guest-c", "2026-01-03"),

new file mode 100644
index 0000000..d9d24a7
--- /dev/null
+++ b/frontend/scripts/diagram-store-test.ts
@@ -0,0 +1,110 @@
+/** 回答图解随会话保存:localStorage 序列化必须保留 anchorIndex/spec。 */
+/* eslint-disable */
+declare const process: { exit(code: number): void }
+
+const memory = new Map<string, string>()
+let failDiagramWrites = false
+const localStorageMock = {
+  getItem: (key: string) => memory.get(key) ?? null,
+  setItem: (key: string, value: string) => {
+    if (failDiagramWrites && value.includes('"diagrams"')) {
+      throw new Error('QuotaExceededError')
+    }
+    memory.set(key, String(value))
+  },
+  removeItem: (key: string) => memory.delete(key),
+  clear: () => memory.clear(),
+  key: (index: number) => Array.from(memory.keys())[index] ?? null,
+  get length() { return memory.size },
+}
+;(globalThis as unknown as { localStorage: typeof localStorageMock }).localStorage = localStorageMock
+
+async function main() {
+  // 旧版本/手改数据里可能有“类型与结构不符”的图解;恢复时必须丢弃。
+  memory.set('mg-learn-sessions', JSON.stringify({
+    sessions: [{
+      id: 9,
+      messages: [{
+        id: 1, role: 'assistant', content: '旧回答',
+        diagrams: [
+          {
+            id: 'bad', anchorIndex: 0,
+            spec: { type: 'surface3d', nodes: [{ id: 'a', label: 'A' }],
+              edges: [], shapes: [], annotations: [] },
+          },
+          {
+            id: 'ok', anchorIndex: 1,
+            spec: { type: 'relation', nodes: [{ id: 'a', label: 'A' }],
+              edges: [], shapes: [], annotations: [] },
+          },
+        ],
+      }, null],
+    }],
+    activeId: 9, msgId: 1, sessionId: 9,
+  }))
+
+  const { sessionStore } = await import('../src/stores/sessions')
+  const learn = sessionStore('learn')
+  if (learn.state.sessions[0]?.messages.length !== 1) {
+    throw new Error('invalid message prevented recovery of valid session')
+  }
+  const restored = learn.state.sessions[0]?.messages[0]?.diagrams
+  if (restored?.length !== 1 || restored[0].id !== 'ok') {
+    throw new Error(`bad diagram was not rejected: ${JSON.stringify(restored)}`)
+  }
+
+  const store = sessionStore('research')
+  store.state.sessions.push({
+    id: 1,
+    messages: [{
+      id: 1, role: 'assistant', content: '前文后文',
+      diagrams: [{
+        id: 'r1-1', anchorIndex: 2,
+        spec: {
+          type: 'relation',
+          nodes: [{ id: 'a', label: 'A' }],
+          edges: [], shapes: [], annotations: [],
+        },
+      }],
+    }],
+  })
+  if (!store.flushSessions(true)) throw new Error('flushSessions failed')
+  const raw = memory.get('mg-research-sessions') || '{}'
+  const parsed = JSON.parse(raw) as {
+    sessions?: Array<{ messages?: Array<{ diagrams?: Array<{ anchorIndex?: number; spec?: { type?: string } }> }> }>
+  }
+  const diagram = parsed.sessions?.[0]?.messages?.[0]?.diagrams?.[0]
+  if (diagram?.anchorIndex !== 2 || diagram?.spec?.type !== 'relation') {
+    throw new Error(`diagram not persisted: ${raw}`)
+  }
+
+  const first = store.state.sessions[0].messages[0]
+  for (let i = 0; i < 25; i++) {
+    store.state.sessions[0].messages.push({
+      id: i + 2, role: 'assistant', content: '图解', diagrams: first.diagrams,
+    })
+  }
+  if (!store.flushSessions(true)) throw new Error('many diagrams failed to save')
+  const saved = memory.get('mg-research-sessions') || ''
+  const savedMessages = JSON.parse(saved).sessions[0].messages
+  if (savedMessages.filter((m: { diagrams?: unknown[] }) => m.diagrams?.length).length !== 26) {
+    throw new Error('saved diagrams were silently discarded')
+  }
+
+  // 配额失败不能覆盖上一次完整存档;恢复后可重试保存新内容。
+  first.content = '新的回答'
+  failDiagramWrites = true
+  if (store.flushSessions(true)) throw new Error('quota failure should report false')
+  if (memory.get('mg-research-sessions') !== saved) throw new Error('quota failure overwrote archive')
+  failDiagramWrites = false
+  if (!store.flushSessions(true)) throw new Error('retry failed')
+  if (JSON.parse(memory.get('mg-research-sessions') || '{}').sessions[0].messages[0].content !== '新的回答') {
+    throw new Error('retry lost new content')
+  }
+  console.log('图解释放/恢复自测通过')
+}
+
+main().catch((err) => {
+  console.error(err instanceof Error ? err.message : String(err))
+  process.exit(1)
+})
diff --git a/frontend/scripts/diagram-test.ts b/frontend/scripts/diagram-test.ts
new file mode 100644
index 0000000..77b96e6
--- /dev/null
+++ b/frontend/scripts/diagram-test.ts
@@ -0,0 +1,163 @@
+/** 图解协议:白名单、上限、消息锚点分段。 */
+/* eslint-disable */
+declare const process: { exit(code: number): void }
+
+import {
+  appendDiagram,
+  buildPaperDiagram,
+  filterCollapsed,
+  parseDiagramEvent,
+  parseDiagramSpec,
+  splitMessageBlocks,
+  type DiagramBlock,
+  type DiagramSpec,
+} from '../src/utils/diagramSpec'
+import { layoutFlow, layoutRelation, layoutTree } from '../src/utils/diagramLayout'
+
+let passed = 0
+const failed: string[] = []
+function check(name: string, ok: boolean, detail = '') {
+  if (ok) passed++
+  else failed.push(`${name}${detail ? `: ${detail}` : ''}`)
+}
+
+const relation = parseDiagramSpec({
+  type: 'relation',
+  nodes: [{ id: 'a', label: 'A' }, { id: 'b', label: 'B' }],
+  edges: [{ from: 'a', to: 'b', label: '推出' }],
+})
+check('合法 relation', relation?.nodes?.length === 2)
+check('schema 版本写入', relation?.schemaVersion === 1)
+check('未来 schema 拒绝', parseDiagramSpec({
+  schemaVersion: 2,
+  type: 'relation',
+  nodes: [{ id: 'a', label: 'A' }],
+}) === null)
+check('非法类型拒绝', parseDiagramSpec({ type: 'script' }) === null)
+check('超限节点拒绝', parseDiagramSpec({
+  type: 'relation',
+  nodes: Array.from({ length: 41 }, (_, i) => ({ id: `n${i}`, label: `N${i}` })),
+}) === null)
+check('超限边拒绝', parseDiagramSpec({
+  type: 'relation',
+  nodes: [{ id: 'a', label: 'A' }],
+  edges: Array.from({ length: 81 }, () => ({ from: 'a', to: 'a' })),
+}) === null)
+check('非法坐标拒绝', parseDiagramSpec({
+  type: 'geometry2d',
+  shapes: [{ kind: 'point', x: Number.NaN, y: 0 }],
+}) === null)
+
+const blocks = splitMessageBlocks('第一段\n\n第二段', [{
+  id: 'd1',
+  anchorIndex: 6,
+  spec: relation!,
+}])
+check('按锚点分段', blocks.length === 3 && blocks[1].kind === 'diagram')
+check('锚点越界钳制', splitMessageBlocks('abc', [{
+  id: 'd2',
+  anchorIndex: 999,
+  spec: relation!,
+}]).length === 2)
+
+const event = parseDiagramEvent({
+  mg_event: 'diagram',
+  requestId: 'r1',
+  anchorId: 'd1',
+  anchorIndex: 12,
+  diagram: relation,
+})
+check('图解事件', event?.id === 'd1' && event?.anchorIndex === 12)
+check('非法事件拒绝', parseDiagramEvent({ mg_event: 'diagram', diagram: { type: 'x' } }) === null)
+const firstAppend = appendDiagram(undefined, event!)
+const secondAppend = appendDiagram(firstAppend, event!)
+check('图解去重', firstAppend.length === 1 && secondAppend.length === 1)
+let capped = secondAppend
+for (const id of ['d2', 'd3', 'd4', 'd5', 'd6', 'd7']) {
+  capped = appendDiagram(capped, { ...event!, id })
+}
+check('单消息最多六张图', capped.length === 6)
+
+const surfacePoints = Array.from({ length: 1681 }, (_, i) => [i % 41, i / 41, 0])
+const bigSpec = parseDiagramSpec({
+  type: 'surface3d',
+  shapes: [{ kind: 'surface', points: surfacePoints }],
+})
+let totalBudget = appendDiagram(undefined, { id: 'p1', anchorIndex: 0, spec: bigSpec! })
+for (const id of ['p2', 'p3', 'p4', 'p5']) {
+  totalBudget = appendDiagram(totalBudget, { id, anchorIndex: 1, spec: bigSpec! })
+}
+check('单消息总点数上限', totalBudget.length === 4)
+
+const threeD = parseDiagramSpec({
+  type: 'surface3d',
+  shapes: [{
+    kind: 'surface', expr: 'x^2+y^2', domain: [-1, 1], rows: 3, cols: 3,
+    points: [[0, 0, 0], [0, 1, 1]],
+  }],
+  annotations: [{ x: 1, y: 1, z: 2, text: '最陡上升' }],
+})
+check('三维标注保留 z', threeD?.annotations[0]?.z === 2)
+check('曲面网格保留行列', threeD?.shapes[0]?.rows === 3 && threeD?.shapes[0]?.cols === 3)
+
+const treeSpec: DiagramSpec = {
+  type: 'tree',
+  nodes: [
+    { id: 'root', label: '论文' },
+    { id: 'a', label: '研究问题' },
+    { id: 'b', label: '方法' },
+  ],
+  edges: [{ from: 'root', to: 'a' }, { from: 'root', to: 'b' }],
+  shapes: [], annotations: [],
+}
+const tree = layoutTree(treeSpec)
+check('树布局节点完整', tree.nodes.length === 3)
+check('树布局父子顺序', tree.nodes[0].y < tree.nodes[1].y)
+check('树布局尺寸有效', tree.width > 0 && tree.height > 0)
+check('树布局边完整', tree.edges.length === 2)
+const collapsedRoot = filterCollapsed(treeSpec, new Set(['root']))
+check('折叠根节点只留根', collapsedRoot.nodes.length === 1
+  && collapsedRoot.edges.length === 0)
+const collapsedChild = filterCollapsed(treeSpec, new Set(['a']))
+check('折叠子节点不影响兄弟', collapsedChild.nodes.length === 3
+  && collapsedChild.edges.length === 2)
+
+const relationSpec: DiagramSpec = {
+  type: 'relation', nodes: [
+    { id: 'x', label: '概念 X' }, { id: 'y', label: '概念 Y' },
+  ], edges: [{ from: 'x', to: 'y' }], shapes: [], annotations: [],
+}
+const relationLayout = layoutRelation(relationSpec)
+check('关系图节点有限坐标', relationLayout.nodes.every((n) =>
+  Number.isFinite(n.x) && Number.isFinite(n.y)))
+check('关系图不重叠', relationLayout.nodes[0].x !== relationLayout.nodes[1].x
+  || relationLayout.nodes[0].y !== relationLayout.nodes[1].y)
+
+const flowSpec: DiagramSpec = {
+  type: 'flow', nodes: [
+    { id: 's1', label: '第一步' }, { id: 's2', label: '第二步' },
+  ], edges: [{ from: 's1', to: 's2' }], shapes: [], annotations: [],
+}
+const flow = layoutFlow(flowSpec)
+check('流程图顺序', flow.nodes[0].x < flow.nodes[1].x
+  || flow.nodes[0].y < flow.nodes[1].y)
+check('流程图边完整', flow.edges.length === 1)
+
+const paper = buildPaperDiagram({
+  question: '如何提高催化效率?',
+  methods: ['方法 A', '方法 B'],
+  conclusions: ['结论 A'],
+  limitations: ['样本有限'],
+  outline: [{ title: '第一章', children: [{ title: '1.1 背景', children: [] }] }],
+}, '测试论文')
+check('论文脑图根节点', paper.nodes[0]?.label === '测试论文')

diff --git a/backend/research_sources.py b/backend/research_sources.py
new file mode 100644
index 0000000..a576262
--- /dev/null
+++ b/backend/research_sources.py
@@ -0,0 +1,105 @@
+"""文献来源注册表与学科路由。
+
+只登记允许进入检索的来源;未登记来源不得出现在结果里。
+每个来源声明:适用学科、权威层级、是否同行评审、是否需要 key、全文策略。
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+
+@dataclass(frozen=True)
+class SourceSpec:
+    id: str
+    name: str
+    domains: tuple[str, ...]
+    tier: str                 # authority | discovery | preprint | repository
+    peer_reviewed: bool
+    requires_key: str = ""    # 可选/必需 key 的环境变量名
+    key_required: bool = False
+    fulltext: str = "landing"  # pdf | oa | landing | metadata
+
+
+SPECS: dict[str, SourceSpec] = {
+    "crossref": SourceSpec(
+        "crossref", "Crossref",
+        ("general", "math", "physics", "chemistry", "biology"),
+        "authority", True),
+    "arxiv": SourceSpec(
+        "arxiv", "arXiv",
+        ("general", "math", "physics", "chemistry", "biology"),
+        "preprint", False, fulltext="pdf"),
+    "europepmc": SourceSpec(
+        "europepmc", "Europe PMC",
+        ("general", "biology", "chemistry"),
+        "authority", True, fulltext="oa"),
+    "pubmed": SourceSpec(
+        "pubmed", "PubMed",
+        ("biology",),
+        "authority", True, requires_key="MG_NCBI_API_KEY"),
+    "inspire": SourceSpec(
+        "inspire", "INSPIRE-HEP",
+        ("physics",),
+        "authority", True, fulltext="oa"),
+    "zbmath": SourceSpec(
+        "zbmath", "zbMATH Open",
+        ("math",),
+        "authority", True),
+    "openalex": SourceSpec(
+        "openalex", "OpenAlex",
+        ("general", "math", "physics", "chemistry", "biology"),
+        "discovery", False, requires_key="MG_OPENALEX_API_KEY",
+        key_required=True, fulltext="oa"),
+    "semanticscholar": SourceSpec(
+        "semanticscholar", "Semantic Scholar",
+        ("general", "math", "physics", "chemistry", "biology"),
+        "discovery", False, requires_key="MG_S2_API_KEY", fulltext="oa"),
+    "biorxiv": SourceSpec(
+        "biorxiv", "bioRxiv / medRxiv",
+        ("biology",),
+        "preprint", False, fulltext="pdf"),
+    "chemrxiv": SourceSpec(
+        "chemrxiv", "ChemRxiv",
+        ("chemistry",),
+        "preprint", False, fulltext="landing"),
+    "doaj": SourceSpec(
+        "doaj", "DOAJ",
+        ("general", "math", "physics", "chemistry", "biology"),
+        "authority", True, fulltext="landing"),
+}
+
+ALL_FIELDS = ("general", "math", "physics", "chemistry", "biology")
+
+
+def specs_for(field: str, include_preprints: bool) -> list[SourceSpec]:
+    """按学科选来源;general 只取声明了 general 的跨学科来源。"""
+    field = field if field in ALL_FIELDS else "general"
+    out: list[SourceSpec] = []
+    for spec in SPECS.values():
+        if field == "general":
+            if "general" not in spec.domains:
+                continue
+        elif field not in spec.domains:
+            continue
+        if spec.tier == "preprint" and not include_preprints:
+            continue
+        out.append(spec)
+    return out
+
+
+def source_tier(name: str) -> str:
+    spec = SPECS.get(name)
+    return spec.tier if spec else "unknown"
+
+
+SOURCE_PRIORITY = {
+    "zbmath": 3, "inspire": 3, "pubmed": 3,
+    "europepmc": 2, "crossref": 2,
+    "arxiv": 1, "biorxiv": 1, "chemrxiv": 1,
+    "openalex": 0, "semanticscholar": 0, "doaj": 0,
+}
+
+
+def source_priority(result: dict) -> int:
+    return max((SOURCE_PRIORITY.get(str(s), 0) for s in result.get("sources") or []),
+               default=0)
diff --git a/backend/research_venues.py b/backend/research_venues.py
new file mode 100644
index 0000000..8967313
--- /dev/null
+++ b/backend/research_venues.py
@@ -0,0 +1,88 @@
+"""场所权威 registry:ISSN 优先匹配,返回学科内的 T0/T1/T2/T3。
+
+registry 是人工维护的种子表,不是 JCR/中科院分区的复制品;
+没有匹配到的场所不猜级别,由调用方按来源类型降级为 T3/P/U。
+"""
+from __future__ import annotations
+
+import json
+import re
+from functools import lru_cache
+from pathlib import Path
+
+_DATA = Path(__file__).resolve().parent / "registry" / "venues.json"
+
+TIER_RANK = {"T0": 5, "T1": 4, "T2": 3, "T3": 2, "P": 1, "U": 0}
+
+
+def normalize_issn(value: object) -> str:
+    text = re.sub(r"[^0-9Xx]", "", str(value or "")).upper()
+    return text if len(text) == 8 else ""
+
+
+def normalize_name(value: object) -> str:
+    text = str(value or "").lower()
+    text = text.replace("&", " and ")
+    text = re.sub(r"[^a-z0-9]+", " ", text)
+    text = re.sub(r"^the\s+", "", text)
+    return re.sub(r"\s+", " ", text).strip()
+
+
+@lru_cache(maxsize=1)
+def _registry() -> tuple[dict[str, dict], dict[str, dict], str]:
+    payload = json.loads(_DATA.read_text(encoding="utf-8"))
+    by_issn: dict[str, dict] = {}
+    by_name: dict[str, dict] = {}
+    for venue in payload.get("venues", []):
+        if not isinstance(venue, dict):
+            continue
+        for raw in venue.get("issn", []):
+            issn = normalize_issn(raw)
+            if issn:
+                by_issn[issn] = venue
+        names = [venue.get("name"), *(venue.get("aliases") or [])]
+        for name in names:
+            key = normalize_name(name)
+            if key:
+                by_name[key] = venue
+    return by_issn, by_name, str(payload.get("version") or "")
+
+
+def registry_version() -> str:
+    return _registry()[2]
+
+
+def lookup(issns: list[str] | tuple[str, ...] | None = None,
+           name: str = "") -> dict | None:
+    by_issn, by_name, _ = _registry()
+    for raw in issns or []:
+        hit = by_issn.get(normalize_issn(raw))
+        if hit:
+            return hit
+    return by_name.get(normalize_name(name)) if name else None
+
+
+def tier_for(venue: dict | None, field: str) -> str:
+    if not venue:
+        return ""
+    tiers = venue.get("tiers") if isinstance(venue.get("tiers"), dict) else {}
+    if field in tiers:
+        return str(tiers[field])
+    if "general" in tiers:
+        return str(tiers["general"])
+    return ""
+
+
+def peer_reviewed(venue: dict | None) -> bool:
+    return bool(venue.get("peer_reviewed")) if venue else False
+
+
+def label(venue: dict | None) -> str:
+    if not venue:
+        return ""
+    publisher = str(venue.get("publisher") or "")
+    return str(venue.get("name") or "") + (f" · {publisher}" if publisher else "")
+
+
+def rank(tier: str) -> int:
+    return TIER_RANK.get(tier, 0)

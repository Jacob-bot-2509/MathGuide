+        return rows
+    computed = compute(columns, rows, formulas)["computed"]
+    out: list[list[str]] = []
+    for row_index, row in enumerate(rows):
+        resolved = list(row)
+        resolved.extend([""] * (len(columns) - len(resolved)))

+    gesture.startX = remaining.x
+    gesture.startY = remaining.y
+    gesture.startPanelX = focusPanel.value.x
+    gesture.startW = focusPanel.value.w
+    gesture.startH = focusPanel.value.h
+    gesture.sawMulti = true
+  }

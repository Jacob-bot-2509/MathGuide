+    const scale = focusDistance(focusGesture.pointers) / focusGesture.startDistance
+    focusPanel.value = resizeFocusPanel({
+      x: focusGesture.startPanelX,
+      w: focusGesture.startW,
+      h: focusGesture.startH,

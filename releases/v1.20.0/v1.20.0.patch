+        try { detail = (JSON.parse(raw) as { detail?: unknown }).detail } catch { /* plain text */ }
+        if (typeof detail === 'string' && detail.length <= 100) error.message = detail
+      } catch { /* keep HTTP status */ }
+    }
+    throw error
+  }
   return (await res.json()) as T
 }
 

+        taxonomy.validate_topics("analysis", ["analysis"], ["not-a-topic"])
+
+
+def test_validate_topics_rejects_empty_topics():
+    with pytest.raises(taxonomy.TaxonomyError, match="不能为空"):
+        taxonomy.validate_topics("analysis", [])

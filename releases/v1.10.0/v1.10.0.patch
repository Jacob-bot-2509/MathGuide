+  border-radius: 14px;
+  box-shadow: 0 0 42px rgba(77, 214, 255, 0.22), 0 18px 48px rgba(0, 0, 0, 0.55);
+  text-align: center;
+}
+
+.todo-kicker {
+  color: var(--cyan);
+  font-size: 10px;
+  letter-spacing: 0.18em;
+  margin: 0 0 7px;
+}
+
+.todo-dialog h2 {
+  margin: 0;
+  color: var(--text-hi);
+  font-size: 19px;
+  letter-spacing: 0.04em;
+}
+
+.todo-hint {
+  margin: 7px 0 13px;
+  color: var(--text-dim);
+  font-size: 12px;
+  line-height: 1.6;
+}
+
+.todo-reminder-list {
+  list-style: none;
+  margin: 0 0 16px;
+  padding: 0;
+  max-height: 34vh;
+  overflow-y: auto;
+  border-top: 1px solid var(--line);
+}
+
+.todo-reminder-item {
+  display: flex;
+  align-items: baseline;
+  gap: 9px;
+  padding: 9px 2px;
+  border-bottom: 1px solid var(--line);
+  text-align: left;
+}
+
+.todo-reminder-time {
+  flex-shrink: 0;
+  color: var(--cyan);
+  font-family: var(--font-tech);

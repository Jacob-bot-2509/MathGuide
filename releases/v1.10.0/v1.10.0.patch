new file mode 100644
index 0000000..ae2a4a3
--- /dev/null
+++ b/backend/evaluation/extract.py
@@ -0,0 +1,121 @@
+"""答案抽取与客观判分。
+
+原则:能机器判的先用机器判;解析不确定时返回 None,交给 LLM 评审,
+绝不因为解析失败直接判错(避免假阴性污染准确率)。
+"""
+from __future__ import annotations
+
+import re
+
+from .types import EvalItem
+
+_BOXED_RE = re.compile(r"\\boxed\s*\{([^{}]+)\}")
+_NUMBER_RE = re.compile(r"[-+]?\d+(?:\.\d+)?(?:[eE][-+]?\d+)?")
+_ANSWER_CHOICE_RE = re.compile(
+    r"(?:正确答案|答案)\s*(?:是|为)?\s*[:：]?\s*([A-Da-d])\b")
+_SELECT_CHOICE_RE = re.compile(
+    r"(?:应选|选择)\s*(?:是|为)?\s*[:：]?\s*([A-Da-d])\b")
+
+try:  # sympy 是可选依赖:没装时表达式题自动降级给 LLM 评审
+    import sympy as _sympy
+except Exception:  # noqa: BLE001
+    _sympy = None
+
+
+def extract_boxed(text: str) -> str:
+    matches = _BOXED_RE.findall(text)
+    return matches[-1].strip() if matches else ""
+
+
+def extract_numbers(text: str) -> list[float]:
+    """按出现顺序返回所有数字(数值题用:答案里常夹带 2σ、区间端点等噪声)。"""
+    nums: list[float] = []
+    for raw in _NUMBER_RE.findall(text):
+        try:
+            nums.append(float(raw))
+        except ValueError:
+            continue
+    return nums
+
+
+def extract_number(text: str) -> float | None:
+    boxed = extract_boxed(text)
+    source = boxed or text
+    nums = extract_numbers(source)
+    return nums[-1] if nums else None
+
+
+def extract_choice(text: str) -> str:
+    # 只认显式作答。"选项 D（…）" 往往是选项说明,不能当答案(否则取到最后一个选项)。
+    matches = _ANSWER_CHOICE_RE.findall(text)
+    if matches:
+        return matches[-1].upper()
+    matches = _SELECT_CHOICE_RE.findall(text)
+    if matches:
+        return matches[-1].upper()
+    stripped = text.strip()
+    if re.fullmatch(r"[A-Da-d]", stripped):
+        return stripped.upper()
+    # 没有显式标记时不猜:宁可交给 LLM 评审,也不误判
+    return ""
+
+
+def _clean_expr(expr: str) -> str:
+    expr = expr.strip().strip("$").strip()
+    expr = expr.replace("\\left", "").replace("\\right", "")
+    expr = expr.replace("\\,", "").replace("\\;", "").replace("\\!", "")
+    expr = expr.replace("\\cdot", "*").replace("\\times", "*")
+    expr = expr.replace("\\pi", "pi")
+    expr = re.sub(r"\\frac\s*\{([^{}]+)\}\s*\{([^{}]+)\}", r"((\1)/(\2))", expr)
+    expr = re.sub(r"\\sqrt\s*\{([^{}]+)\}", r"sqrt(\1)", expr)
+    expr = expr.replace("^", "**")
+    return expr
+
+
+def _sympy_equal(a: str, b: str) -> bool | None:
+    if _sympy is None:
+        return None
+    try:
+        left = _sympy.sympify(_clean_expr(a))
+        right = _sympy.sympify(_clean_expr(b))
+        return bool(_sympy.simplify(left - right) == 0)
+    except Exception:  # noqa: BLE001 解析失败交给 LLM
+        return None
+
+
+def objective_check(item: EvalItem, answer: str) -> tuple[bool | None, str]:
+    """返回 (是否正确, 判分说明)。None 表示无法客观判定。"""
+    ref = item.reference_answer.strip()
+    if not ref:
+        return None, "无标准答案"
+
+    if item.answer_type == "choice":
+        got, want = extract_choice(answer), extract_choice(ref)
+        if got and want:
+            return got == want, f"choice: {got} vs {want}"
+        return None, "选项无法解析"
+
+    if item.answer_type == "numeric":
+        want = extract_number(ref)
+        # 不只看最后一个数字:答案里可能后出现 "2σ""区间端点" 等噪声。
+        # 标准答案的数字出现在回答任意位置即判对;这偏宽松,但避免解析假阴性。
+        nums = extract_numbers(extract_boxed(answer) or answer)
+        if want is None or not nums:
+            return None, "数值无法解析"
+        scale = max(1.0, abs(want))
+        matched = [n for n in nums if abs(n - want) <= 1e-6 * scale]
+        return bool(matched), f"numeric: ref={want}, got={matched or nums[-1]}"
+
+    if item.answer_type == "expr":
+        got = extract_boxed(answer)
+        want = extract_boxed(ref)
+        if not got or not want:
+            # 标准答案可能不带 boxed,退化为整段比较
+            got = got or answer
+            want = want or ref
+        result = _sympy_equal(got, want)
+        if result is None:
+            return None, "表达式无法符号化"
+        return result, f"expr: {_clean_expr(got)} vs {_clean_expr(want)}"
+
+    return None, "主观题"
diff --git a/backend/evaluation/judges.py b/backend/evaluation/judges.py
new file mode 100644
index 0000000..d0bac65
--- /dev/null
+++ b/backend/evaluation/judges.py
@@ -0,0 +1,112 @@
+"""LLM 评审:判正确性 + 拆断言判是否有依据。
+
+注意:评审模型必须与生成模型不同源(默认 backup/glm),否则是自评。
+评审结果只是"模型判分",论文里必须再用人工盲标校准 kappa。
+"""
+from __future__ import annotations
+
+import json
+import re
+
+from rag import llm
+
+from .types import ChunkTrace, EvalItem
+
+JUDGE_SYSTEM = (
+    "你是严格的数学评测员。给定题目、标准答案、检索资料和待评答案,只输出一个 JSON 对象,"
+    "不要 Markdown、不要解释。字段:\n"
+    "{\n"
+    '  "correct": true/false,\n'
+    '  "score": 0 | 0.5 | 1,\n'
+    '  "refused": true/false,\n'
+    '  "claims": [{"text": "关键断言", "supported": true/false, "reason": "依据"}],\n'
+    '  "rationale": "一句话"\n'
+    "}\n"
+    "规则:\n"
+    "1. correct 表示最终结论是否与标准答案一致;等价形式也算正确。\n"
+    "2. refused 表示待评答案是否明确拒答或声明资料不足。\n"
+    "3. claims 取最多 8 条关键断言;supported 仅当该断言能被标准答案或检索资料直接支持,"
+    "或属于题目给出的条件。无依据、与资料矛盾、把猜测说成事实,都记 false。"
+    "不得以「数学常识」「众所周知」为由判 supported:标准答案和检索资料都没写的,一律 false。\n"
+    "4. 标准答案为空(不可答题)时,correct 表示是否恰当拒答;不要因为答案看起来合理就判正确。\n"
+    "5. 计算错误但没编造事实:correct=false,但对应断言的 supported 仍可为 true。\n"
+)
+
+
+def _context(chunks: list[ChunkTrace], limit: int = 3, per_chunk: int = 700) -> str:
+    if not chunks:
+        return "(无检索资料)"
+    parts = []
+    for i, c in enumerate(chunks[:limit], 1):
+        parts.append(f"[{i}] {c.title} · {c.section}\n{c.text[:per_chunk]}")
+    return "\n\n".join(parts)
+
+
+def _parse_json(text: str) -> dict:
+    text = text.strip()
+    if text.startswith("```"):
+        text = re.sub(r"^```(?:json)?\s*", "", text)
+        text = re.sub(r"\s*```$", "", text)
+    start, end = text.find("{"), text.rfind("}")
+    if start < 0 or end <= start:
+        raise ValueError("评审输出不含 JSON 对象")
+    data = json.loads(text[start:end + 1])
+    if not isinstance(data, dict):
+        raise ValueError("评审输出不是 JSON 对象")
+    return data
+
+
+def _normalize(data: dict, item: EvalItem) -> dict:
+    claims = []
+    raw_claims = data.get("claims")
+    if isinstance(raw_claims, list):
+        for c in raw_claims[:12]:
+            if not isinstance(c, dict):
+                continue
+            text = str(c.get("text", "")).strip()
+            if not text:
+                continue
+            claims.append({
+                "text": text[:300],
+                "supported": bool(c.get("supported", False)),
+                "reason": str(c.get("reason", ""))[:200],
+            })
+    correct = data.get("correct")
+    if not isinstance(correct, bool):
+        correct = None
+    if not item.answerable and isinstance(data.get("refused"), bool):
+        # 不可答题:正确 = 明确拒答
+        correct = bool(data["refused"])
+    return {
+        "correct": correct,
+        "score": data.get("score") if data.get("score") in (0, 0.5, 1, 0.0, 1.0) else None,
+        "refused": bool(data.get("refused")) if isinstance(data.get("refused"), bool) else None,
+        "claims": claims,
+        "rationale": str(data.get("rationale", ""))[:300],
+    }
+
+
+async def judge_answer(item: EvalItem, answer: str, chunks: list[ChunkTrace],
+                       role: str = "backup") -> dict:
+    """返回评审 JSON;失败时返回 {"error": ...},调用方需计入 judge_errors。"""
+    if not llm.is_configured(role):
+        return {"error": f"评审角色 {role} 未配置"}
+    prompt = (
+        f"题目:\n{item.question}\n\n"
+        f"标准答案:\n{item.reference_answer or '(不可答题,无标准答案)'}\n\n"
+        f"检索资料:\n{_context(chunks)}\n\n"
+        f"待评答案:\n{answer[:3000]}"
+    )
+    parts: list[str] = []
+    try:
+        async for delta in llm.stream_chat(JUDGE_SYSTEM, prompt, role=role,
+                                           fallback=False, thinking=False,
+                                           max_tokens=1200):
+            parts.append(delta)
+    except Exception as exc:  # noqa: BLE001 评审失败不伪造结果
+        return {"error": f"{type(exc).__name__}: {exc}"}
+    try:
+        return _normalize(_parse_json("".join(parts)), item)
+    except Exception as exc:  # noqa: BLE001
+        return {"error": f"评审输出解析失败: {type(exc).__name__}: {exc}",
+                "raw": "".join(parts)[:500]}
diff --git a/backend/evaluation/metrics.py b/backend/evaluation/metrics.py
new file mode 100644
index 0000000..fdf2df1
--- /dev/null
+++ b/backend/evaluation/metrics.py
@@ -0,0 +1,147 @@
+"""指标计算:准确率、幻觉率、检索命中/召回、Wilson 置信区间。
+
+口径:
+- accuracy       = 判为正确的可答题 / 已判可答题
+- answer_halluc  = 至少 1 条无依据断言的回答 / 有断言且可判的回答
+- claim_halluc   = 无依据断言数 / 总断言数
+- fabrication    = 不可答题中未拒答的比例
+- hit@k          = top-k 命中任一金标片段的问题比例
+- recall@k       = top-k 命中的金标片段数 / 金标片段总数(按题平均)
+- mrr@k          = 首个金标片段排名的倒数(按题平均)
+"""
+from __future__ import annotations
+
+import math
+
+
+def wilson_ci(k: int, n: int, z: float = 1.96) -> tuple[float, float]:
+    """二项比例的 Wilson 95% 置信区间。n=0 时返回 (0,1)。"""
+    if n <= 0:
+        return 0.0, 1.0
+    p = k / n
+    denom = 1 + z * z / n
+    center = (p + z * z / (2 * n)) / denom
+    margin = z * math.sqrt(p * (1 - p) / n + z * z / (4 * n * n)) / denom
+    return max(0.0, center - margin), min(1.0, center + margin)
+
+
+def _rate(k: int, n: int) -> dict:
+    lo, hi = wilson_ci(k, n)
+    return {"k": k, "n": n, "rate": (k / n) if n else None, "ci95": [round(lo, 4), round(hi, 4)]}
+
+
+def _answer_correct(record: dict) -> bool | None:
+    judge = record.get("judge") or {}
+    if "objective_correct" in record and record["objective_correct"] is not None:
+        return bool(record["objective_correct"])
+    correct = judge.get("correct")
+    return bool(correct) if isinstance(correct, bool) else None
+
+
+def _claims(record: dict) -> list[dict]:
+    judge = record.get("judge") or {}
+    claims = judge.get("claims") or []
+    return [c for c in claims if isinstance(c, dict) and isinstance(c.get("supported"), bool)]
+
+
+def retrieval_metrics(records: list[dict]) -> dict:
+    with_gold = [r for r in records if r.get("gold_chunk_ids")]
+    if not with_gold:
+        return {"n": 0, "hit_rate": None, "recall": None, "mrr": None}
+    hits = 0
+    recalls: list[float] = []
+    rrs: list[float] = []
+    for r in with_gold:
+        gold = set(r["gold_chunk_ids"])
+        ids = [c.get("id") for c in (r.get("retrieval") or {}).get("chunks", [])]
+        rank = next((i + 1 for i, cid in enumerate(ids) if cid in gold), None)
+        hits += 1 if rank else 0
+        recalls.append(len(gold & set(ids)) / len(gold) if gold else 0.0)
+        rrs.append(1.0 / rank if rank else 0.0)
+    n = len(with_gold)
+    return {
+        "n": n,
+        "hit_rate": _rate(hits, n),
+        "recall": round(sum(recalls) / n, 4),
+        "mrr": round(sum(rrs) / n, 4),
+    }
+
+
+def compute_metrics(records: list[dict]) -> dict:
+    answerable = [r for r in records if r.get("answerable", True) and _answer_correct(r) is not None]
+    correct = [r for r in answerable if _answer_correct(r)]
+    judged = [r for r in records if r.get("answerable", True) and _claims(r)]
+    halluc_answers = [r for r in judged if any(not c["supported"] for c in _claims(r))]
+    total_claims = sum(len(_claims(r)) for r in judged)
+    bad_claims = sum(sum(1 for c in _claims(r) if not c["supported"]) for r in judged)
+
+    unanswerable = [r for r in records if not r.get("answerable", True)]
+    judged_unanswerable = [
+        r for r in unanswerable
+        if (r.get("judge") and not r["judge"].get("error"))
+        or r.get("objective_correct") is not None
+    ]
+    fabricated = []
+    for r in judged_unanswerable:
+        judge = r.get("judge") or {}
+        refused = judge.get("refused")
+        if isinstance(refused, bool):
+            if not refused:
+                fabricated.append(r)
+        elif _answer_correct(r) is True:
+            # 不可答题里 judge 判 correct 且没有 refused 字段:按未拒答处理
+            fabricated.append(r)
+
+    judged_all = [r for r in records if r.get("judge") and not (r["judge"].get("error"))]
+    run_errors = [r for r in records if r.get("error")]
+    judge_errors = [r for r in records if (r.get("judge") or {}).get("error")]
+    degraded = [r for r in records if r.get("degraded")]
+
+    summary = {
+        "n_items": len(records),
+        "retrieval": retrieval_metrics(records),
+        "answers": {
+            "n_judged_answerable": len(answerable),
+            "accuracy": _rate(len(correct), len(answerable)),
+            "n_judged_claims": len(judged),
+            "answer_hallucination": _rate(len(halluc_answers), len(judged)),
+            "claim_hallucination": {
+                "bad_claims": bad_claims,
+                "total_claims": total_claims,
+                "rate": (bad_claims / total_claims) if total_claims else None,
+            },
+        },
+        "unanswerable": {
+            "n": len(judged_unanswerable),
+            "fabrication": _rate(len(fabricated), len(judged_unanswerable)),
+        },
+        "health": {
+            "run_errors": len(run_errors),
+            "judge_errors": len(judge_errors),
+            "judged": len(judged_all),
+            "degraded": len(degraded),
+            "degraded_rate": (len(degraded) / len(records)) if records else None,
+        },
+    }
+    summary["by_domain"] = _group(records, "domain")
+    summary["by_difficulty"] = _group(records, "difficulty")
+    summary["by_answer_type"] = _group(records, "answer_type")
+    return summary
+
+
+def _group(records: list[dict], key: str) -> dict:
+    groups: dict[str, list[dict]] = {}
+    for r in records:
+        groups.setdefault(str(r.get(key, "other")), []).append(r)
+    out: dict[str, dict] = {}
+    for name, rows in sorted(groups.items()):
+        answerable = [r for r in rows if r.get("answerable", True) and _answer_correct(r) is not None]
+        correct = [r for r in answerable if _answer_correct(r)]
+        judged = [r for r in rows if r.get("answerable", True) and _claims(r)]
+        halluc = [r for r in judged if any(not c["supported"] for c in _claims(r))]
+        out[name] = {
+            "n": len(rows),
+            "accuracy": _rate(len(correct), len(answerable)),
+            "answer_hallucination": _rate(len(halluc), len(judged)),
+        }
+    return out
diff --git a/backend/evaluation/report.py b/backend/evaluation/report.py
new file mode 100644
index 0000000..d9349e3
--- /dev/null
+++ b/backend/evaluation/report.py
@@ -0,0 +1,93 @@
+"""评测结果落盘与 Markdown 报告。"""
+from __future__ import annotations
+
+import json
+import time
+from pathlib import Path
+
+
+def _fmt_rate(block: dict | None) -> str:
+    if not block or block.get("rate") is None:
+        return "—"
+    lo, hi = block.get("ci95", [0, 1])
+    return f"{block['rate']:.3f} [{lo:.3f}, {hi:.3f}] (n={block['n']})"
+
+
+def write_outputs(out_dir: str | Path, records: list[dict], summary: dict,
+                  config: dict) -> tuple[Path, Path, Path]:
+    out = Path(out_dir)
+    out.mkdir(parents=True, exist_ok=True)
+    answers_path = out / "records.jsonl"
+    summary_path = out / "summary.json"
+    report_path = out / "report.md"
+
+    with open(answers_path, "w", encoding="utf-8") as f:
+        for r in records:
+            f.write(json.dumps(r, ensure_ascii=False) + "\n")
+    payload = {"generated_at": time.strftime("%Y-%m-%d %H:%M:%S"),
+               "config": config, "summary": summary}
+    with open(summary_path, "w", encoding="utf-8") as f:
+        json.dump(payload, f, ensure_ascii=False, indent=2)
+
+    lines = [
+        "# MathGuide 评测报告",
+        "",
+        f"- 生成时间:{payload['generated_at']}",
+        f"- 数据集:{config.get('data')} (hash `{config.get('dataset_hash')}`)",
+        f"- 阶段:{config.get('stage')};检索 top-k:{config.get('top_k')}",
+        f"- 评审角色:{config.get('judge_role')};条数:{summary.get('n_items')}",
+        "",
+        "## 总览",
+        "",
+        "| 指标 | 值 |",
+        "|---|---|",
+        f"| 正确率 | {_fmt_rate((summary.get('answers') or {}).get('accuracy'))} |",
+        f"| 答案级幻觉率 | {_fmt_rate((summary.get('answers') or {}).get('answer_hallucination'))} |",
+        f"| 不可答编造率 | {_fmt_rate((summary.get('unanswerable') or {}).get('fabrication'))} |",
+        f"| 检索 hit@k | {_fmt_rate((summary.get('retrieval') or {}).get('hit_rate'))} |",
+        f"| 检索 recall@k | {(summary.get('retrieval') or {}).get('recall', '—')} |",
+        f"| 检索 MRR@k | {(summary.get('retrieval') or {}).get('mrr', '—')} |",
+        "",
+    ]
+    claim = (summary.get("answers") or {}).get("claim_hallucination") or {}
+    lines += [
+        "## 断言级幻觉",
+        "",
+        f"- 无依据断言:{claim.get('bad_claims', 0)} / {claim.get('total_claims', 0)}",
+        f"- 比例:{claim.get('rate') if claim.get('rate') is not None else '—'}",
+        "",
+    ]
+    health = summary.get("health") or {}
+    lines += [
+        "## 运行健康度",
+        "",
+        f"- 运行错误:{health.get('run_errors', 0)}",
+        f"- 评审失败:{health.get('judge_errors', 0)}",
+        f"- 降级回答:{health.get('degraded', 0)} / {summary.get('n_items', 0)}",
+        "",
+    ]
+
+    for title, key in (("按板块", "by_domain"), ("按难度", "by_difficulty"),
+                       ("按题型", "by_answer_type")):
+        lines += [f"## {title}", "", "| 分组 | n | 正确率 | 答案级幻觉率 |", "|---|---|---|---|"]
+        for name, row in (summary.get(key) or {}).items():
+            lines.append(
+                f"| {name} | {row['n']} | {_fmt_rate(row.get('accuracy'))} | "
+                f"{_fmt_rate(row.get('answer_hallucination'))} |")
+        lines.append("")
+
+    failures = [r for r in records if r.get("objective_correct") is False
+                or (r.get("judge") or {}).get("correct") is False
+                or r.get("error")]
+    lines += ["## 失败样本(前 20)", ""]
+    if not failures:
+        lines.append("无。")
+    else:
+        for r in failures[:20]:
+            reason = r.get("error") or r.get("objective_detail") or \
+                (r.get("judge") or {}).get("rationale") or "判错"
+            lines.append(f"- `{r['id']}` {r['question']} — {str(reason)[:200]}")
+    lines.append("")
+
+    report_path.write_text("\n".join(lines), encoding="utf-8")
+    return answers_path, summary_path, report_path

@@ -0,0 +1,28 @@
+# MathGuide 后端 systemd 示例。
+# 路径按实际部署修改:User / WorkingDirectory / EnvironmentFile / ExecStart。
+# data/ 是唯一需要写的目录,其余只读;umask 让数据文件默认不对其他用户开放。
+
+[Unit]
+Description=MathGuide backend
+After=network.target
+
+[Service]
+Type=simple
+User=mathguide
+Group=mathguide
+WorkingDirectory=/srv/mathguide/backend
+EnvironmentFile=/srv/mathguide/backend/.env.local
+ExecStart=/srv/mathguide/.venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port 8000
+Restart=on-failure
+RestartSec=3
+UMask=0077
+NoNewPrivileges=true
+PrivateTmp=true
+ProtectSystem=strict
+ProtectHome=true
+ReadWritePaths=/srv/mathguide/backend/data
+StandardOutput=append:/var/log/mathguide/backend.log
+StandardError=append:/var/log/mathguide/backend.log
+
+[Install]
+WantedBy=multi-user.target
diff --git a/deploy/nginx.conf b/deploy/nginx.conf
new file mode 100644
index 0000000..04827aa
--- /dev/null
+++ b/deploy/nginx.conf
@@ -0,0 +1,46 @@
+# MathGuide 生产部署示例(Nginx)
+#
+# 前置:前端 npm run build,root 指向 frontend/dist;
+# 后端只绑 127.0.0.1:8000,MG_DEMO_MODE=0。
+# 证书路径按实际修改;首次上线先注释 HSTS,确认 HTTPS 正常后再打开。
+
+server {
+    listen 80;
+    server_name mg.example.com;
+    return 301 https://$host$request_uri;
+}
+
+server {
+    listen 443 ssl http2;
+    server_name mg.example.com;
+
+    ssl_certificate     /etc/letsencrypt/live/mg.example.com/fullchain.pem;
+    ssl_certificate_key /etc/letsencrypt/live/mg.example.com/privkey.pem;
+
+    root /srv/mathguide/frontend/dist;
+    index index.html;
+
+    location /api/ {
+        proxy_pass http://127.0.0.1:8000;
+        proxy_http_version 1.1;
+        proxy_set_header Host $host;
+        proxy_set_header X-Forwarded-Proto $scheme;
+        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
+        # SSE 不能缓冲
+        proxy_buffering off;
+        proxy_read_timeout 300s;
+    }
+
+    location / {
+        try_files $uri $uri/ /index.html;
+    }
+
+    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
+    add_header X-Content-Type-Options "nosniff" always;
+    add_header Referrer-Policy "no-referrer" always;
+    add_header X-Frame-Options "DENY" always;
+    add_header Permissions-Policy "camera=(), geolocation=(), microphone=(self)" always;
+    # KaTeX 会写内联 style,因此保留 style-src 'unsafe-inline';
+    # 脚本与连接都限制在自身域名,前端已无内联脚本。
+    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'" always;
+}

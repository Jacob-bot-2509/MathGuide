+        </button>
+        <button class="todo-tab" :class="{ on: tab === 'schedule' }" @click="tab = 'schedule'">
+          {{ t('todo.tabSchedule') }} <span>{{ scheduledTasks.length }}</span>
+        </button>
+      </div>
+
+      <div class="todo-body">
+        <div class="todo-form">

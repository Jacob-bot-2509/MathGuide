+
+/** 序列化 SVG(补 xmlns,脱离页面样式也能打开) */
+function svgText(): string {
+  if (!svgEl.value) return ''
+  const clone = svgEl.value.cloneNode(true) as SVGSVGElement
+  clone.setAttribute('xmlns', 'http://www.w3.org/2000/svg')

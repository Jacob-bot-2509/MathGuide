+): Promise<Annotation> {
+  const res = await post<{ annotation: Annotation }>(
+    `/api/research/docs/${encodeURIComponent(docId)}/annotations`,
+    input, authHeaders())
+  return res.annotation
+}
+
+export async function deleteAnnotation(
+  docId: string,
+  annotationId: string,
+): Promise<void> {

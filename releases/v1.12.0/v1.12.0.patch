+        />
+        <text
+          v-for="(tick, i) in yTicks"
+          :key="`ty-${i}`"
+          :x="PAD.left - 9"
+          :y="sy(tick) + 4"
+          fill="#94a3b8"
+          font-size="10.5"
+          text-anchor="end"
+        >{{ fmt(tick) }}</text>
+        <text
+          v-for="(tick, i) in xTicks"
+          :key="`tx-${i}`"
+          :x="tick.x"
+          :y="H - PAD.bottom + 20"
+          fill="#94a3b8"
+          font-size="10.5"
+          text-anchor="middle"
+        >{{ tick.label }}</text>
+      </g>
+
+      <line
+        :x1="PAD.left"
+        :x2="W - PAD.right"
+        :y1="sy(0)"
+        :y2="sy(0)"
+        stroke="#475569"
+        stroke-width="1"
+      />
+      <line
+        :x1="PAD.left"
+        :x2="PAD.left"
+        :y1="PAD.top"
+        :y2="PAD.top + PLOT_H"
+        stroke="#475569"

+export async function uploadTempPaper(
+  file: File,
+): Promise<{
+  docId: string
+  duplicate: boolean
+  status?: string
+  pages?: number
+  doi?: string
+}> {
+  const type = file.type || (file.name.toLowerCase().endsWith('.pdf')
+    ? 'application/pdf'
+    : 'text/plain')
+  return upload(
+    `/api/research/docs?name=${encodeURIComponent(file.name)}&temp=1`,
+    file,
+    type,
+    authHeaders(),
+  )

+.pw-msg.user .pw-bubble {
+  background: color-mix(in srgb, var(--cyan) 12%, var(--bg-card));
+  border-color: color-mix(in srgb, var(--cyan) 35%, var(--line));
+  color: var(--text-hi);
+}
+
+.pw-msg.assistant .pw-bubble {
+  white-space: normal;
+}
+
+.pw-thinking,
+.pw-cursor {
+  color: var(--text-dim);
+}
+
+.pw-note {
+  margin: 0;
+  padding: 0 12px 6px;
+  color: var(--text-dim);
+  font-size: 10px;
+  line-height: 1.5;
+}
+
+.pw-input {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  padding: 8px 10px 10px;
+  border-top: 1px solid var(--line);
+  flex: none;
+}
+
+.pw-input input {
+  flex: 1;
+  min-width: 0;
+  background: var(--bg-card);
+  border: 1px solid var(--line);
+  border-radius: 7px;
+  color: var(--text);
+  font-size: 12.5px;
+  padding: 7px 9px;
+  outline: none;
+}
+
+.pw-input input:focus {
+  border-color: var(--line-bright);
+}
+
+.pw-send,
+.pw-insight-toggle {
+  background: transparent;
+  border: 1px solid var(--line-bright);
+  color: var(--cyan);
+  border-radius: 6px;
+  font-size: 11.5px;
+  padding: 6px 10px;
+  cursor: pointer;
+  white-space: nowrap;
+}
+
+.pw-send:disabled {
+  opacity: 0.45;
+  cursor: default;
+}
+
+.pw-send.stop {
+  color: #ff8a8a;
+  border-color: rgba(255, 138, 138, 0.45);
+}
+
+.pw-insight-toggle {
+  padding: 6px 8px;
+}
+
+.pw-insight-toggle.on {
+  box-shadow: var(--glow-cyan);
+}
+
+.pw-reader {
+  position: relative;
+  flex: 1;
+  min-width: 0;
+}
+
+.pw-loading {
+  padding: 20px;
+}
+
+@media (max-width: 900px) {
+  .pw {
+    inset: 0;
+    border-radius: 0;
+  }
+
+  .pw-chat {
+    width: 42%;
+    min-width: 220px;
+  }
+
+  .pw-body.with-insights .pw-chat {
+    display: none;
+  }
+}
+</style>

+  headers?: Record<string, string>,
+): Promise<T> {
+  const res = await fetch(`${BASE_URL}${path}`, {
+    method: 'POST',
+    headers: { 'Content-Type': contentType, ...(headers ?? {}) },
+    body: file,
+    credentials: 'include',
+  })
+  if (!res.ok) throw await uploadError(res)
+  return (await res.json()) as T
+}
+

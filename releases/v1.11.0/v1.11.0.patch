+
+def _bump_version(conn: sqlite3.Connection) -> None:
+    """索引内容变更(论文/切片/归属)后 +1,内存索引据此失效。
+    WAL 模式下主库 mtime 不一定变化,不能再用文件时间戳判断。"""
+    conn.execute("UPDATE meta SET value = CAST(CAST(value AS INTEGER) + 1 AS TEXT)"
+                 " WHERE key = 'version'")

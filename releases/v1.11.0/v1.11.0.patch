+      return
+    }
+    showToast(t('graph.ratingError'))
+  } finally {
+    ratingBusy.value = false
+  }
+}
+
+function switchStrategy(next: RecommendStrategy) {
+  strategy.value = next
+  void loadRecommendation()
+}
+
+function selectById(id: string) {
+  const node = nodeById.value.get(id)
+  if (node) pick(node)
+}

+}
+
+.fm-list {
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+  padding: 12px 16px 16px;
+}
+
+.fm-best {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  padding: 8px 10px;
+  border: 1px solid color-mix(in srgb, var(--cyan) 45%, transparent);
+  border-radius: 7px;
+  background: color-mix(in srgb, var(--cyan) 10%, transparent);
+  color: var(--text-hi);
+  font-size: 11.5px;
+}
+
+.fm-best button {
+  margin-left: auto;
+  background: transparent;
+  border: 1px solid var(--line-bright);
+  color: var(--cyan);
+  border-radius: 5px;
+  font-size: 11px;
+  padding: 3px 9px;
+  cursor: pointer;
+}
+
+.fm-card {
+  border: 1px solid var(--line);
+  border-radius: 8px;

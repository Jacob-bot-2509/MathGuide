+    if author:
+        parts.append(f'author:"{author}"')
+    year_from = filters.get("yearFrom")
+    year_to = filters.get("yearTo")
+    if year_from or year_to:
+        parts.append(
+            f"year:[{year_from or 1900} TO {year_to or time.localtime().tm_year}]")
+    params = {
+        "q": " AND ".join(parts),

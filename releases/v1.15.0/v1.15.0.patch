+def _save_source_blocks(uid: str, doc_id: str, page: int,
+                        formulas: list[dict]) -> int:
+    """保存公式识别来源区块;手写公式单独标记,供后续低置信复核。"""
+    doc_id = doc_id[:64]
+    if not doc_id or not formulas:
+        return 0
+    page = max(0, min(int(page or 0), 100000))
+    conn = _connect(uid)
+    inserted = 0
+    try:
+        conn.commit()
+        conn.execute("BEGIN IMMEDIATE")
+        if not conn.execute(
+                "SELECT 1 FROM docs WHERE id = ? AND deleted_at IS NULL", (doc_id,)).fetchone():
+            return 0
+        now = time.time()
+        for item in formulas[:20]:
+            if not isinstance(item, dict):
+                continue
+            expr = str(item.get("expr") or "").strip()[:300]
+            target = str(item.get("target") or "").strip()[:60]
+            if not expr:
+                continue
+            handwriting = item.get("handwriting")
+            kind = ("handwriting_formula" if handwriting is True else
+                    "printed_formula" if handwriting is False else "unknown_formula")
+            confidence = _confidence(item.get("confidence"))
+            conn.execute(
+                "INSERT INTO source_blocks(id, doc_id, page, kind, text, latex,"
+                " confidence, created_at, source_type) VALUES(?,?,?,?,?,?,?,?,?)",
+                (secrets.token_hex(10), doc_id, page, kind,
+                 f"{target} = {expr}"[:500], expr, confidence,
+                 now, "formula"))
+            inserted += 1
+        conn.commit()
+        return inserted
+    finally:
+        conn.close()
+

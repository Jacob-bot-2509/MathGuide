+def _tree_bytes(path: Path) -> int:
+    total = 0
+    try:
+        for item in path.rglob("*"):
+            try:
+                if item.is_file():
+                    total += item.stat().st_size
+            except OSError:
+                continue
+    except OSError:
+        return total
+    return total
+
+
+def _storage_stats(uid: str) -> dict:
+    root = _user_dir(uid)
+    files = 0
+    derived = _tree_bytes(root / "derived")
+    for path in (root / "files").rglob("*"):
+        try:
+            if path.is_file():
+                if path.name.endswith(".pages.json"):
+                    derived += path.stat().st_size
+                else:
+                    files += path.stat().st_size
+        except OSError:
+            continue
+    for name in (".embeddings.json", ".embeddings.json.tmp"):
+        try:
+            derived += (root / name).stat().st_size
+        except OSError:
+            continue
+    docs = temp = trash = 0
+    conn = _connect(uid)
+    try:
+        for status, deleted, count in conn.execute(
+                "SELECT status, deleted_at, COUNT(*) FROM docs GROUP BY status, deleted_at"):
+            if deleted:
+                trash += count
+            elif status == "temp":
+                temp += count
+            else:
+                docs += count
+    except sqlite3.Error:
+        pass
+    finally:
+        conn.close()
+    db_bytes = 0
+    for name in ("index.sqlite3", "index.sqlite3-wal", "index.sqlite3-shm"):
+        try:
+            db_bytes += (root / name).stat().st_size
+        except OSError:
+            continue
+    return {
+        "docs": docs, "temp": temp, "trash": trash,
+        "filesBytes": files, "derivedBytes": derived, "dbBytes": db_bytes,
+        "totalBytes": files + derived + db_bytes,
+    }
+
+
+def _purge_user_caches(uid: str) -> dict:
+    with _index_lock:
+        had_index = uid in _indexes
+        _indexes.pop(uid, None)
+        _index_paths.pop(uid, None)
+    return {"indexCleared": had_index}
+
+
+async def storage_usage(request: Request) -> JSONResponse:
+    rec = require_auth(request)
+    uid = str(rec.get("uid") or "")

diff --git a/frontend/src/utils/diagramIntent.ts b/frontend/src/utils/diagramIntent.ts
new file mode 100644
index 0000000..cd73c74
--- /dev/null
+++ b/frontend/src/utils/diagramIntent.ts
@@ -0,0 +1,51 @@
+/** 图解意图:识别用户本轮/最近一次明确说过的“不要画图”和“恢复画图”。 */
+
+export interface DiagramHistoryItem {
+  role: string
+  content: string
+}
+
+// 与后端 research_diagrams._NO_DIAGRAM_RE 保持同一口径:
+// “先不要画图 / 不用配图 / 别画了 / 不要画思维导图”都算停止指令。
+const NO_DIAGRAM_RE = /(?:先|暂时|这次|本轮|本次|今天)?\s*(?:不要|不用|不需要|不必|无需|别|不)\s*(?:再|先|急着|用)?\s*(?:画|生成|出|配|做|给|用|展示)?\s*(?:图|图解|图示|图像|示意图|思维导图|可视化)|(?:不要|不用|别|无需)\s*(?:再|先)?\s*(?:画|生成|配|做)(?:了|吧|啦)?(?=\s|$|[，。,.!?])|\b(?:do not|don't|dont|no need to|without|skip)\s+(?:draw|drawing|generate|show|include|using)?\s*(?:a\s+)?(?:diagram|figure|graph|chart|visuali[sz]ation)\b/i
+
+const DRAW_AGAIN_RE = /(?:可以|现在|继续|开始|还是|重新|恢复|请|帮我)?\s*(?:画|生成|出|做|配|给)\s*(?:一?张|个)?\s*(?:三维|3d|二维|2d|立体|函数|曲线|几何|流程|思维导图|关系)?\s*(?:图|图解|图示|图像|示意图)|\b(?:draw|show|generate|include)\s+(?:a\s+)?(?:diagram|figure|graph|chart)\b|(?:用|来)\s*(?:一?张|个)?\s*(?:三维|3d|二维|2d|立体|函数|曲线|几何|流程|思维导图|关系)?\s*(?:图|图解|图示|图像|示意图)/i
+
+function messageState(text: string): boolean | null {
+  const body = text || ''
+  const negative = NO_DIAGRAM_RE.exec(body)
+  const positive = DRAW_AGAIN_RE.exec(body)
+  // 同一句里“不要画思维导图,画三维图”以后半句为准。
+  if (positive && (!negative || positive.index > negative.index + negative[0].length)) {
+    return false
+  }
+  if (negative) return true
+  if (positive) return false
+  return null
+}
+
+/** 本轮是否被用户明确要求不画图;最近的明确指令优先,直到用户恢复。 */
+export function diagramSuppressed(
+  question: string,
+  history: DiagramHistoryItem[] = [],
+): boolean {
+  const current = messageState(question)
+  if (current !== null) return current
+  for (let index = history.length - 1; index >= 0; index -= 1) {
+    const item = history[index]
+    if (item.role !== 'user') continue
+    const state = messageState(item.content || '')
+    if (state !== null) return state
+  }
+  return false
+}
+
+/** 用户明显在问“怎么理解/几何直观/关系/区别”,或明确要求画图时,允许回答结束后补一张图。 */
+export function needsDiagram(
+  question: string,
+  history: DiagramHistoryItem[] = [],
+): boolean {
+  if (diagramSuppressed(question, history)) return false
+  return /怎么理解|如何理解|怎么直观|几何直观|直观理解|怎么想|有什么关系|什么关系|有什么区别|为什么会|推导|证明思路|三维|3d|立体|曲面|梯度|画(?:个|张|一)?图|图示|示意图|可视化|一步步|逐步|图解|how (?:can|do|to) .*understand|geometric intuition|intuition|relationship|difference|draw|diagram|3d|surface|gradient/i
+    .test(question || '')
+}
diff --git a/frontend/src/utils/diagramLabels.ts b/frontend/src/utils/diagramLabels.ts
new file mode 100644
index 0000000..c3c117d
--- /dev/null
+++ b/frontend/src/utils/diagramLabels.ts
@@ -0,0 +1,683 @@
+/** 图解文字布局:先量文字,再在锚点四周找不压图形、不压其他标签的位置。 */
+
+import type { DiagramShape } from './diagramSpec'
+
+export type Side = 'top' | 'bottom' | 'left' | 'right'
+
+export interface Rect {
+  x: number
+  y: number
+  w: number
+  h: number
+}
+
+export interface LabelRequest {
+  id: string
+  text: string
+  anchorX: number
+  anchorY: number
+  role?: 'annotation' | 'shape' | 'axis' | 'edge'
+  fontSize?: number
+  maxWidth?: number
+  maxLines?: number
+  priority?: number
+  /** 主体图形的包围盒;标注优先排到它外面。 */
+  figure?: Rect | null
+  /** 与 figure 相交的惩罚权重;0 表示不关心。 */
+  figureWeight?: number
+  preferred?: Side[]
+  /** 轴名等固定标签:不移动,只占位。 */
+  fixed?: boolean
+}
+
+export interface PlacedLabel {
+  id: string
+  text: string
+  role: 'annotation' | 'shape' | 'axis' | 'edge'
+  lines: string[]
+  x: number
+  y: number
+  w: number
+  h: number
+  anchorX: number
+  anchorY: number
+  fontSize: number
+  lineHeight: number
+  side: Side | 'center'
+  leader: boolean
+}
+
+export interface ScreenLabelRequest {
+  id: string
+  anchorX: number
+  anchorY: number
+  width: number
+  height: number
+  priority?: number
+  fixed?: boolean
+  avoidRect?: Rect | null
+  avoidWeight?: number
+  preferred?: Side[]
+}
+
+export interface ScreenLabelPlacement {
+  id: string
+  x: number
+  y: number
+  w: number
+  h: number
+  centerX: number
+  centerY: number
+  side: Side | 'center'
+  leader: boolean
+  overlapsAvoid: boolean
+  overlapsLabel: boolean
+}
+
+const CJK_RE = /[　-鿿＀-￯]/
+const ELLIPSIS = '…'
+
+export function charWidth(ch: string, fontSize: number): number {
+  if (CJK_RE.test(ch)) return fontSize
+  if (ch === ' ') return fontSize * 0.34
+  if (/[.,:;']/u.test(ch)) return fontSize * 0.32
+  if ('()[]{}<>+-*/=^_|'.includes(ch)) return fontSize * 0.48
+  return fontSize * 0.6
+}
+
+export function measureTextWidth(text: string, fontSize: number): number {
+  let width = 0
+  for (const ch of Array.from(text)) width += charWidth(ch, fontSize)
+  return width
+}
+
+function truncateLine(text: string, maxWidth: number, fontSize: number): string {
+  const chars = Array.from(text)
+  const dotWidth = charWidth(ELLIPSIS, fontSize)
+  let width = 0
+  let out = ''
+  for (const ch of chars) {
+    const next = charWidth(ch, fontSize)
+    if (out && width + next > Math.max(1, maxWidth - dotWidth)) break
+    out += ch
+    width += next
+  }
+  return out.length < chars.length ? `${out}${ELLIPSIS}` : out
+}
+
+export interface MeasuredLabel {
+  lines: string[]
+  w: number
+  h: number
+  fontSize: number
+  lineHeight: number
+}
+
+export function measureLabel(request: LabelRequest): MeasuredLabel {
+  const fontSize = Math.max(8, request.fontSize ?? 10)
+  const lineHeight = Math.round(fontSize * 1.28)
+  const maxWidth = Math.max(fontSize * 2, request.maxWidth ?? 160)
+  const maxLines = Math.max(1, Math.floor(request.maxLines ?? 3))
+  const chars = Array.from(request.text.trim())
+  const lines: string[] = []
+  let current = ''
+  let currentWidth = 0
+  for (let index = 0; index < chars.length; index += 1) {
+    const ch = chars[index]
+    const width = charWidth(ch, fontSize)
+    if (current && currentWidth + width > maxWidth) {
+      lines.push(current)
+      current = ''
+      currentWidth = 0
+      if (lines.length >= maxLines) {
+        lines[maxLines - 1] = truncateLine(
+          `${lines[maxLines - 1]}${chars.slice(index).join('')}`,
+          maxWidth,
+          fontSize,
+        )
+        return {
+          lines,
+          w: Math.max(1, ...lines.map((line) => measureTextWidth(line, fontSize))) + 4,
+          h: lines.length * lineHeight + 2,
+          fontSize,
+          lineHeight,
+        }
+      }
+    }
+    current += ch
+    currentWidth += width
+  }
+  if (current) lines.push(current)
+  if (!lines.length) lines.push('')
+  return {
+    lines,
+    w: Math.max(1, ...lines.map((line) => measureTextWidth(line, fontSize))) + 4,
+    h: lines.length * lineHeight + 2,
+    fontSize,
+    lineHeight,
+  }
+}
+
+export function overlapArea(a: Rect, b: Rect): number {
+  const left = Math.max(a.x, b.x)
+  const right = Math.min(a.x + a.w, b.x + b.w)
+  const top = Math.max(a.y, b.y)
+  const bottom = Math.min(a.y + a.h, b.y + b.h)
+  return Math.max(0, right - left) * Math.max(0, bottom - top)
+}
+
+export function pointRectDistance(rect: Rect, x: number, y: number): number {
+  const dx = Math.max(rect.x - x, 0, x - (rect.x + rect.w))
+  const dy = Math.max(rect.y - y, 0, y - (rect.y + rect.h))
+  return Math.hypot(dx, dy)
+}
+
+function clamp(value: number, low: number, high: number): number {
+  return Math.min(high, Math.max(low, value))
+}
+
+function sideOf(dx: number, dy: number): Side {
+  if (Math.abs(dx) >= Math.abs(dy)) return dx < 0 ? 'left' : 'right'
+  return dy < 0 ? 'top' : 'bottom'
+}
+
+interface Candidate {
+  rect: Rect
+  side: Side | 'center'
+  distance: number
+}
+
+function localCandidates(
+  request: LabelRequest,
+  label: MeasuredLabel,
+  gaps: number[],
+): Candidate[] {
+  const out: Candidate[] = []
+  const { anchorX: ax, anchorY: ay } = request
+  const { w, h } = label
+  for (const gap of gaps) {
+    const boxes: Array<[number, number, Side]> = [
+      [ax - w / 2, ay - gap - h, 'top'],
+      [ax - w / 2, ay + gap, 'bottom'],
+      [ax - gap - w, ay - h / 2, 'left'],
+      [ax + gap, ay - h / 2, 'right'],
+      [ax - gap - w, ay - gap - h, 'left'],
+      [ax + gap, ay - gap - h, 'right'],
+      [ax - gap - w, ay + gap, 'left'],
+      [ax + gap, ay + gap, 'right'],
+    ]
+    for (const [x, y, side] of boxes) {
+      const rect = { x, y, w, h }
+      out.push({
+        rect,
+        side,
+        distance: pointRectDistance(rect, ax, ay),
+      })
+    }
+  }
+  return out
+}
+
+function figureCandidates(
+  request: LabelRequest,
+  label: MeasuredLabel,
+  gaps: number[],
+): Candidate[] {
+  const figure = request.figure
+  if (!figure) return []
+  const out: Candidate[] = []
+  const { anchorX: ax, anchorY: ay } = request
+  const { w, h } = label
+  const centerX = figure.x + figure.w / 2
+  const centerY = figure.y + figure.h / 2
+  for (const gap of gaps) {
+    // 优先落在主体外围的上/下/左/右,让多条说明自然分散。
+    const boxes: Array<[number, number, Side]> = [
+      [
+        clamp(ax, figure.x + w / 2, figure.x + figure.w - w / 2) - w / 2,
+        figure.y - gap - h,
+        'top',
+      ],
+      [
+        clamp(ax, figure.x + w / 2, figure.x + figure.w - w / 2) - w / 2,
+        figure.y + figure.h + gap,
+        'bottom',
+      ],
+      [
+        figure.x - gap - w,
+        clamp(ay, figure.y + h / 2, figure.y + figure.h - h / 2) - h / 2,
+        'left',
+      ],
+      [
+        figure.x + figure.w + gap,
+        clamp(ay, figure.y + h / 2, figure.y + figure.h - h / 2) - h / 2,
+        'right',
+      ],
+    ]
+    for (const [x, y, side] of boxes) {
+      const rect = { x, y, w, h }
+      out.push({
+        rect,
+        side,
+        distance: pointRectDistance(rect, ax, ay),
+      })
+    }
+    // 锚点离主体中心越远,越应该从对应角落排出,避免所有标签挤同一侧。
+    const cornerX = ax < centerX ? figure.x - gap - w : figure.x + figure.w + gap
+    const cornerY = ay < centerY ? figure.y - gap - h : figure.y + figure.h + gap
+    out.push({
+      rect: { x: cornerX, y: cornerY, w, h },
+      side: sideOf(cornerX + w / 2 - ax, cornerY + h / 2 - ay),
+      distance: pointRectDistance({ x: cornerX, y: cornerY, w, h }, ax, ay),
+    })
+  }
+  return out
+}
+
+function scoreCandidate(
+  candidate: Candidate,
+  request: LabelRequest,
+  bounds: Rect,
+  obstacles: Rect[],
+  placed: Rect[],
+  sideUse: Record<Side, number>,
+): number {
+  const rect = candidate.rect
+  let score = candidate.distance * 0.2
+  const overflowX = Math.max(0, bounds.x - rect.x)
+    + Math.max(0, rect.x + rect.w - (bounds.x + bounds.w))
+  const overflowY = Math.max(0, bounds.y - rect.y)
+    + Math.max(0, rect.y + rect.h - (bounds.y + bounds.h))
+  score += (overflowX + overflowY) * 1e7
+  for (const other of placed) {
+    const area = overlapArea(rect, other)
+    if (area > 0) score += 1e6 + area * 1e4
+    else if (pointRectDistance(other, rect.x, rect.y) < 2) score += 200
+  }
+  for (const obstacle of obstacles) {
+    const area = overlapArea(rect, obstacle)
+    if (area > 0) score += 40000 + area * 200
+  }
+  if (request.figure && (request.figureWeight ?? 0) > 0) {
+    const area = overlapArea(rect, request.figure)
+    if (area > 0) score += (request.figureWeight ?? 0) * (area + 240)
+  }
+  if (rect.x <= request.anchorX && request.anchorX <= rect.x + rect.w
+    && rect.y <= request.anchorY && request.anchorY <= rect.y + rect.h) {
+    score += 50000
+  }
+  if (request.preferred?.length) {
+    const index = request.preferred.indexOf(candidate.side as Side)
+    if (index < 0) score += 80
+    else score += index * 24
+  }
+  if (candidate.side !== 'center') score += (sideUse[candidate.side] || 0) * 7
+  return score
+}
+
+export function placeLabels(
+  requests: LabelRequest[],
+  obstacles: Rect[],
+  bounds: Rect,
+): PlacedLabel[] {
+  const ordered = [...requests].sort((a, b) => (
+    (b.priority ?? 1) - (a.priority ?? 1) || a.id.localeCompare(b.id)
+  ))
+  const placed: Rect[] = []
+  const sideUse: Record<Side, number> = { top: 0, bottom: 0, left: 0, right: 0 }
+  const byId = new Map<string, PlacedLabel>()
+  const gaps = [8, 16, 26, 40, 60]
+
+  for (const request of ordered) {
+    const label = measureLabel(request)
+    const role = request.role ?? 'annotation'
+    if (request.fixed) {
+      const rect = {
+        x: request.anchorX - label.w / 2,
+        y: request.anchorY - label.h / 2,
+        w: label.w,
+        h: label.h,
+      }
+      placed.push(rect)
+      byId.set(request.id, {
+        id: request.id,
+        text: request.text,
+        role,
+        lines: label.lines,
+        ...rect,
+        anchorX: request.anchorX,
+        anchorY: request.anchorY,
+        fontSize: label.fontSize,
+        lineHeight: label.lineHeight,
+        side: 'center',
+        leader: false,
+      })
+      continue
+    }
+    const candidates = [
+      ...localCandidates(request, label, gaps),
+      ...figureCandidates(request, label, [8, 16, 26, 40]),
+    ]
+    let best = candidates[0]
+    let bestScore = Number.POSITIVE_INFINITY
+    for (const candidate of candidates) {
+      const score = scoreCandidate(
+        candidate, request, bounds, obstacles, placed, sideUse,
+      )
+      if (score < bestScore) {
+        best = candidate
+        bestScore = score
+      }
+    }
+    placed.push(best.rect)
+    if (best.side !== 'center') sideUse[best.side] += 1
+    byId.set(request.id, {
+      id: request.id,
+      text: request.text,
+      role,
+      lines: label.lines,
+      ...best.rect,
+      anchorX: request.anchorX,
+      anchorY: request.anchorY,
+      fontSize: label.fontSize,
+      lineHeight: label.lineHeight,
+      side: best.side,
+      leader: pointRectDistance(best.rect, request.anchorX, request.anchorY) > 1,
+    })
+  }
+
+  return requests
+    .map((request) => byId.get(request.id))
+    .filter((item): item is PlacedLabel => item !== undefined)
+}
+
+export function screenCandidates(
+  request: ScreenLabelRequest,
+  gaps: number[],
+): Candidate[] {
+  const out: Candidate[] = []
+  const { anchorX: ax, anchorY: ay, width: w, height: h } = request
+  for (const gap of gaps) {
+    const boxes: Array<[number, number, Side]> = [
+      [ax - w / 2, ay - gap - h, 'top'],
+      [ax - w / 2, ay + gap, 'bottom'],
+      [ax - gap - w, ay - h / 2, 'left'],
+      [ax + gap, ay - h / 2, 'right'],
+      [ax - gap - w, ay - gap - h, 'left'],
+      [ax + gap, ay - gap - h, 'right'],
+      [ax - gap - w, ay + gap, 'left'],
+      [ax + gap, ay + gap, 'right'],
+    ]
+    for (const [x, y, side] of boxes) {

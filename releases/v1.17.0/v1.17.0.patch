+
+function normalizeExpression(source: string): string {
+  return source
+    .replace(/[−–—]/g, '-')
+    .replace(/[×·⋅]/g, '*')
+    .replace(/÷/g, '/')
+    .replace(/²/g, '^2')
+    .replace(/³/g, '^3')
+    .replace(/π/g, 'pi')
+    .replace(/\s+/g, '')
+}

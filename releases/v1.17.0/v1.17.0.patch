+    monkeypatch.setattr(rd, "plan_geogebra", no_geo)
+    monkeypatch.setattr(rd, "plan_diagram", legacy)
+    got = asyncio.run(rd.plan_diagram_auto(
+        "画出抛物线", "y=x^2", [], "plot2d", strict=False))
+    assert got is sentinel
